# Copy to guardrails/.env (gitignored) and fill in. Never commit real values.

# Secret used to sign approval tokens. At least 32 bytes. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
GUARDRAILS_APPROVAL_KEY=
# Key id, bump (k2, k3...) when rotating the key
GUARDRAILS_APPROVAL_KEY_ID=k1

# SQLite file holding the action queue and the audit log (gitignored)
GUARDRAILS_DB_PATH=data/guardrails.db

# Frappe REST API: WRITE credentials of the dedicated "guardrails gateway" user.
# Only the Execution Gateway reads these. Agents get their own read-only keys.
FRAPPE_URL=http://localhost:8080
FRAPPE_GATEWAY_API_KEY=
FRAPPE_GATEWAY_API_SECRET=
