{
  "version": "2026-11-01.1",
  "agents": {
    "recruitment_agent": {
      "tools": [
        "rank_candidate",
        "update_applicant_status",
        "schedule_interview",
        "rank_shortlist"
      ]
    },
    "comms_agent": {
      "tools": [
        "send_email",
        "propose_interview_slots",
        "inbox_digest"
      ]
    },
    "hr_assistant": {
      "tools": [
        "answer_employee",
        "log_hr_request"
      ]
    },
    "onboarding_agent": {
      "tools": []
    },
    "leave_agent": {
      "tools": [
        "decide_leave_application"
      ]
    },
    "payroll_agent": {
      "tools": []
    },
    "performance_agent": {
      "tools": []
    },
    "conflict_agent": {
      "tools": []
    },
    "hr_operator": {
      "tools": [
        "update_interview",
        "update_applicant_status",
        "create_leave_application",
        "decide_leave_application",
        "update_employee_job"
      ]
    }
  },
  "tools": {
    "rank_candidate": {
      "description": "Record a score + justification for ONE applicant against ONE job opening",
      "subject_doctypes": [
        "Job Applicant"
      ],
      "rate_limit": {
        "max": 200,
        "window_seconds": 3600
      }
    },
    "update_applicant_status": {
      "description": "Move an applicant in the pipeline (e.g. Open -> Replied)",
      "subject_doctypes": [
        "Job Applicant"
      ],
      "rate_limit": {
        "max": 100,
        "window_seconds": 3600
      }
    },
    "send_email": {
      "description": "Send a reply to the person the action is about. Address resolved from Frappe by the gateway.",
      "subject_doctypes": [
        "Job Applicant",
        "Employee"
      ],
      "max_recipients": 1,
      "recipient_doctypes": [
        "Job Applicant",
        "Employee"
      ],
      "recipient_must_be_subject": true,
      "rate_limit": {
        "max": 30,
        "window_seconds": 3600
      }
    },
    "propose_interview_slots": {
      "description": "Offer interview slots to one applicant",
      "subject_doctypes": [
        "Job Applicant"
      ],
      "max_recipients": 1,
      "recipient_doctypes": [
        "Job Applicant"
      ],
      "recipient_must_be_subject": true,
      "rate_limit": {
        "max": 30,
        "window_seconds": 3600
      }
    },
    "answer_employee": {
      "description": "Answer an employee policy question, to that employee only",
      "subject_doctypes": [
        "Employee"
      ],
      "max_recipients": 1,
      "recipient_doctypes": [
        "Employee"
      ],
      "recipient_must_be_subject": true,
      "rate_limit": {
        "max": 60,
        "window_seconds": 3600
      }
    },
    "schedule_interview": {
      "description": "Create a Frappe HR Interview for ONE applicant (agent-layer 'interview' kind)",
      "subject_doctypes": [
        "Job Applicant"
      ],
      "rate_limit": {
        "max": 30,
        "window_seconds": 3600
      }
    },
    "rank_shortlist": {
      "description": "Propose the ranked shortlist of ONE job opening (agent-layer 'ranking' kind). Decision only: nothing is written to Frappe",
      "subject_doctypes": [
        "Job Opening"
      ],
      "rate_limit": {
        "max": 50,
        "window_seconds": 3600
      }
    },
    "inbox_digest": {
      "description": "Summarise the HR inbox for HR (agent-layer 'digest' kind). Decision only: nothing is written or sent",
      "rate_limit": {
        "max": 30,
        "window_seconds": 3600
      }
    },
    "log_hr_request": {
      "description": "HR Chat: record a request from an employee/applicant for HR to follow up. Decision only: nothing is written to HR Core records",
      "subject_doctypes": [
        "Chat Message"
      ],
      "rate_limit": {
        "max": 120,
        "window_seconds": 3600
      }
    },
    "update_interview": {
      "description": "HR Chat HR mode: reschedule or cancel ONE existing Interview, asked for and confirmed by an HR user",
      "subject_doctypes": [
        "Interview"
      ],
      "rate_limit": {
        "max": 30,
        "window_seconds": 3600
      }
    },
    "create_leave_application": {
      "description": "HR Chat HR mode: create ONE leave application (status Open) for an employee",
      "subject_doctypes": [
        "Employee"
      ],
      "rate_limit": {
        "max": 30,
        "window_seconds": 3600
      }
    },
    "decide_leave_application": {
      "description": "Approve or reject ONE open Leave Application",
      "subject_doctypes": [
        "Leave Application"
      ],
      "rate_limit": {
        "max": 50,
        "window_seconds": 3600
      }
    },
    "update_employee_job": {
      "description": "HR Chat HR mode: change job fields (department, designation, branch, manager) of ONE employee. Never personal data",
      "subject_doctypes": [
        "Employee"
      ],
      "rate_limit": {
        "max": 20,
        "window_seconds": 3600
      }
    }
  }
}
