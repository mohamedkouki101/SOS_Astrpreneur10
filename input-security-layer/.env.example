# Copy to input-security-layer/.env and replace every placeholder. Never commit .env.
# Generate each key separately (all six must be different):
#   python -c "import secrets; print(secrets.token_hex(32))"

# --- HMAC keys (at least 32 characters each) ---
# Signs the envelope sent to the AI layer.
INGEST_SIGNING_KEY=replace-me-signing-key-0000000000000000
# Computes candidate_ref / sender_ref from normalized emails.
INGEST_REF_KEY=replace-me-ref-key-11111111111111111111111

# --- Internal API keys (at least 32 characters each) ---
# Presented by Frappe when it forwards a recruiter's CV upload.
UPLOAD_API_KEY=replace-me-upload-key-2222222222222222222
# Used by the HR dashboard to read inspection reports (they contain PII).
REPORT_API_KEY=replace-me-report-key-44444444444444444444
# Used by the AI layer to read released (masked, signed) envelopes.
ENVELOPE_API_KEY=replace-me-envelope-key-555555555555555555
# Held only by the Execution Gateway to resolve (doc_id, token).
RESOLVER_API_KEY=replace-me-resolver-key-33333333333333333

# --- HR mail ---
# No mailbox settings: Frappe's Email Account receives HR mail and forwards it
# to POST /v1/email (body) and POST /v1/email/attachment (attached CVs).

# --- Sanitizer limits (integers only) ---
MAX_FILE_BYTES=10000000
MAX_PDF_PAGES=20
MAX_ZIP_ENTRIES=1000
MAX_ZIP_UNCOMPRESSED_BYTES=50000000
MAX_ZIP_RATIO=100
MAX_TEXT_CHARS=200000
EXTRACT_TIMEOUT_S=10
EXTRACT_MEMORY_MB=256

# --- Evidence Store root (relative = inside input-security-layer/; Docker uses /data/evidence) ---
EVIDENCE_DIR=./evidence
