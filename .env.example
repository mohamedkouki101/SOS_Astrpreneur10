# Variable NAMES only. Copy to .env and fill locally. Never commit .env.

# RH Flow
RHFLOW_URL=http://localhost:8001
RHFLOW_PROPOSE_ENABLED=0

# Per-agent read-only API users (written by agents/scripts/setup_agent_users.py)
RHFLOW_ORCHESTRATOR_API_KEY=
RHFLOW_ORCHESTRATOR_API_SECRET=
RHFLOW_RECRUITMENT_API_KEY=
RHFLOW_RECRUITMENT_API_SECRET=
RHFLOW_COMMS_API_KEY=
RHFLOW_COMMS_API_SECRET=
RHFLOW_ASSISTANT_API_KEY=
RHFLOW_ASSISTANT_API_SECRET=
RHFLOW_LEAVE_API_KEY=
RHFLOW_LEAVE_API_SECRET=
RHFLOW_ONBOARDING_API_KEY=
RHFLOW_ONBOARDING_API_SECRET=
RHFLOW_PAYROLL_API_KEY=
RHFLOW_PAYROLL_API_SECRET=
RHFLOW_PERFORMANCE_API_KEY=
RHFLOW_PERFORMANCE_API_SECRET=
RHFLOW_CONFLICT_API_KEY=
RHFLOW_CONFLICT_API_SECRET=

# Webhooks (HR Core -> agents)
WEBHOOK_HMAC_SECRET=
WEBHOOK_REPLAY_WINDOW_SECONDS=

# Approval token signing (key management TODO)
APPROVAL_SIGNING_KEY=

# LLM: qwen3:8b via Ollama (local)
OLLAMA_URL=http://localhost:11434
LLM_MODEL=qwen3:8b
LLM_TEMPERATURE=0.1
LLM_NUM_CTX=16384

# Mail ingestion (test mailbox; may be replaced by .eml folder)
IMAP_HOST=
IMAP_PORT=
IMAP_USER=
IMAP_PASSWORD=
EML_FOLDER=

# Budgets and paths
AGENT_MAX_TOOL_CALLS=6
AGENT_MAX_STEPS=8
AGENT_MAX_TOKENS=60000
AGENT_MAX_PROPOSALS=10
DATASET_DIR=
AGENTS_VAR_DIR=

# Test mail server (Mailpit): web inbox http://localhost:8025
# HR inbox backend: mailpit | folder (dataset .eml files)
MAIL_SOURCE=mailpit
MAILPIT_URL=http://localhost:8025
MAILPIT_SMTP_HOST=localhost
MAILPIT_SMTP_PORT=1025
HR_INBOX_ADDRESS=hr@rhflow.local
