# Variable NAMES only. Never commit .env.
# `python3 scripts/setup_stack.py env` creates .env from this file with fresh random keys;
# agents/scripts/setup_agent_users.py fills the per-agent API keys.

# HR Flow
RHFLOW_URL=http://localhost:8001
RHFLOW_PROPOSE_ENABLED=1

# Per-agent read-only API users (written by agents/scripts/setup_agent_users.py)
RHFLOW_ORCHESTRATOR_API_KEY=
RHFLOW_ORCHESTRATOR_API_SECRET=
RHFLOW_RECRUITMENT_API_KEY=
RHFLOW_RECRUITMENT_API_SECRET=
RHFLOW_COMMS_API_KEY=
RHFLOW_COMMS_API_SECRET=
RHFLOW_ASSISTANT_API_KEY=
RHFLOW_ASSISTANT_API_SECRET=
RHFLOW_LEAVE_API_KEY=
RHFLOW_LEAVE_API_SECRET=
RHFLOW_ONBOARDING_API_KEY=
RHFLOW_ONBOARDING_API_SECRET=
RHFLOW_PAYROLL_API_KEY=
RHFLOW_PAYROLL_API_SECRET=
RHFLOW_PERFORMANCE_API_KEY=
RHFLOW_PERFORMANCE_API_SECRET=
RHFLOW_CONFLICT_API_KEY=
RHFLOW_CONFLICT_API_SECRET=
RHFLOW_OPERATOR_API_KEY=
RHFLOW_OPERATOR_API_SECRET=

# Webhooks (HR Core -> agents)
WEBHOOK_HMAC_SECRET=
WEBHOOK_REPLAY_WINDOW_SECONDS=
# Agent service listen address (containers reach it via host.docker.internal)
AGENTS_HOST=
AGENTS_PORT=

# LLM: qwen3:14b via Ollama (local)
OLLAMA_URL=http://localhost:11434
LLM_MODEL=qwen3:14b
LLM_TEMPERATURE=0.1
LLM_NUM_CTX=16384

# Budgets and paths
AGENT_MAX_TOOL_CALLS=6
AGENT_MAX_STEPS=8
AGENT_MAX_TOKENS=60000
AGENT_MAX_PROPOSALS=10
DATASET_DIR=
AGENTS_VAR_DIR=

# Test mail server (Mailpit): web inbox http://localhost:8025
# HR inbox backend: mailpit | folder (dataset .eml files)
MAIL_SOURCE=mailpit
MAILPIT_URL=http://localhost:8025
MAILPIT_SMTP_HOST=localhost
MAILPIT_SMTP_PORT=1025
HR_INBOX_ADDRESS=hr@rhflow.local

# Input security layer (input-security-layer/): service = CVs and emails come from its signed envelopes
INPUT_LAYER=service
INGEST_URL=http://localhost:8090
# Read-only key for released envelopes, and the key to verify their signature (same values as in
# input-security-layer/.env: ENVELOPE_API_KEY and INGEST_SIGNING_KEY). Agents never get the other keys.
INGEST_ENVELOPE_API_KEY=
INGEST_SIGNING_KEY=
