# Copy to .env and replace every placeholder. Never commit .env.
# Generate each key separately (all four must be different):
#   python -c "import secrets; print(secrets.token_hex(32))"

# --- HMAC keys (at least 32 characters each) ---
# Signs the envelope sent to the AI layer.
INGEST_SIGNING_KEY=replace-me-signing-key-0000000000000000
# Computes candidate_ref / sender_ref from normalized emails.
INGEST_REF_KEY=replace-me-ref-key-11111111111111111111111

# --- Internal API keys (at least 32 characters each) ---
# Presented by Frappe when it forwards a recruiter's CV upload.
UPLOAD_API_KEY=replace-me-upload-key-2222222222222222222
# Held only by the Execution Gateway to resolve (doc_id, token).
RESOLVER_API_KEY=replace-me-resolver-key-33333333333333333

# --- HR mailbox (read-only account) ---
IMAP_HOST=localhost
IMAP_PORT=993
IMAP_USE_SSL=true
IMAP_USER=hr-inbox@example.test
IMAP_PASSWORD=replace-me
IMAP_FOLDER=INBOX

# --- Sanitizer limits (integers only) ---
MAX_FILE_BYTES=10000000
MAX_PDF_PAGES=20
MAX_ZIP_ENTRIES=1000
MAX_ZIP_UNCOMPRESSED_BYTES=50000000
MAX_ZIP_RATIO=100
EXTRACT_TIMEOUT_S=10
EXTRACT_MEMORY_MB=256

# --- Evidence Store root (a Docker volume in production) ---
EVIDENCE_DIR=./evidence
